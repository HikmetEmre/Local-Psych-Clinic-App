# Copy to .env (git-ignored) and fill in. Never commit real values.
# Use URL-safe passwords (e.g. `python -c "import secrets; print(secrets.token_hex(24))"`).

# --- Local tier (office laptop) ---
LOCAL_DB_PASSWORD=change-me            # owner role (migrations only)
LOCAL_APP_DB_PASSWORD=change-me        # kasa_app: the web app, subject to row-level security
LOCAL_SYNC_DB_PASSWORD=change-me       # kasa_sync: outbox and mirror tables only
# Generate both keys with:  python -m klinik_local.manage generate-keys
# LOCAL_FERNET_KEYS encrypts client contact details and clinical text ("primary[,older]").
# KEEP AN OFFLINE COPY. Backups hold ciphertext only: losing this key loses every note.
LOCAL_FERNET_KEYS=
LOCAL_AUTH_FERNET_KEY=

# --- Sync worker (office laptop -> cloud, outbound only) ---
SYNC_CLOUD_BASE_URL=https://klinik-web.example.com
# SYNC_CLOUD_TOKEN=   (dedicated, limited credential; added in M5)

# --- Cloud tier (set in Cloud Run, not on the laptop) ---
# CLOUD_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres
# CLOUD_MIGRATION_DATABASE_URL=
