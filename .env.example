# Copy to .env (git-ignored) and fill in. Never commit real values.
# Use URL-safe passwords (e.g. `python -c "import secrets; print(secrets.token_hex(24))"`).

# --- Local tier (office laptop) ---
LOCAL_DB_PASSWORD=change-me            # owner role (migrations only)
LOCAL_APP_DB_PASSWORD=change-me        # kasa_app: the web app, subject to row-level security
LOCAL_SYNC_DB_PASSWORD=change-me       # kasa_sync: outbox and mirror tables only
LOCAL_BACKUP_DB_PASSWORD=change-me     # kasa_backup: pg_dump only
# Generate both keys with:  python -m klinik_local.manage generate-keys
# LOCAL_FERNET_KEYS encrypts client contact details and clinical text ("primary[,older]").
# KEEP AN OFFLINE COPY. Backups hold ciphertext only: losing this key loses every note.
LOCAL_FERNET_KEYS=
LOCAL_AUTH_FERNET_KEY=

# --- Sync worker (office laptop -> cloud, outbound only) ---
SYNC_CLOUD_BASE_URL=https://klinik-web.example.com
# Create in the cloud with: python -m klinik_cloud.manage create-sync-token (shown once)
SYNC_CLOUD_TOKEN=
# Klinik Web address, for the booking links in Klinik Kasa
LOCAL_WEB_BASE_URL=https://klinik-web.example.com

# --- Cloud tier (set in Cloud Run, not on the laptop) ---
# CLOUD_DATABASE_URL=postgresql+asyncpg://cloud_app:PASSWORD@HOST:5432/postgres   (session mode)
# CLOUD_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:5432/postgres
# CLOUD_APP_DB_PASSWORD=
# CLOUD_AUTH_FERNET_KEY=      (python -m klinik_cloud.manage generate-keys)
# CLOUD_VAPID_PRIVATE_KEY=    (same command; Web Push)
# CLOUD_VAPID_PUBLIC_KEY=
# CLOUD_VAPID_SUBJECT=mailto:...   (a contact address for the push services)

# --- Backups (docs/runbooks/backups.md) ---
# Public key only. The private key (age-keygen output) is kept OFFLINE, never on this laptop.
BACKUP_AGE_RECIPIENT=age1...
# rclone remote for Google Drive, e.g. gdrive:klinik-yedek (config in secrets/rclone/rclone.conf)
BACKUP_RCLONE_REMOTE=
# Optional weekly copy of the cloud database (read-only connection string)
BACKUP_CLOUD_DUMP_URL=
